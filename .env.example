# Execution mode: PAPER | TESTNET | LIVE
TRADING_MODE=PAPER

# Binance credentials. Keep real values only in local .env / server secrets.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Trading defaults
QUOTE_ASSET=USDT
PAPER_START_BALANCE=10000
MAX_PORTFOLIO_ALLOCATION_PCT=50
MAX_POSITION_PCT=10
RESERVE_USDT_PCT=20
GRID_POLL_SECONDS=5

# App
APP_HOST=0.0.0.0
APP_PORT=8000
